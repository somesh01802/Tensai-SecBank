# Tensai SecBank — PHP API (Slim 4) environment template.
# Copy to .env and fill in. .env is gitignored.

# PostgreSQL. Must point at the SAME database the Node app used (data is preserved).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/tensai_secbank

# HTTP port the PHP app listens on (behind Apache/nginx reverse proxy at /api).
PORT=8090

# JWT signing secret. MUST be byte-identical to the Node app's JWT_SECRET so
# existing sessions/tokens keep working across the cutover.
JWT_SECRET=change-me-to-the-existing-node-secret

# Frontend origin(s) allowed by CORS (comma-separated).
CORS_ORIGIN=http://localhost:5173

# System user (used by POST /api/transactions/system/initial-funds).
SYSTEM_USER_EMAIL=system@tensai.local
SYSTEM_USER_PASSWORD=change-me

# Chatbot (optional). If ANTHROPIC_API_KEY is empty, the assistant falls back to
# the built-in deterministic rule-based responder (no external calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- 0007: transactions, synthetic activity, telemetry ---
# Per-transaction limit for P2P, external transfers and bill payments.
TRANSFER_LIMIT_PER_TXN=500000
# Email domains (and their sub-domains) treated as synthetic test users. Their
# activity is flagged is_synthetic everywhere and can never move money to/from
# live customers.
SYNTHETIC_EMAIL_DOMAINS=tensai.test
# Lets bin/traffic.php inject infrastructure failures (processor/fraud timeouts,
# network, DB concurrency, outage) via X-Tensai-Fault. Honoured ONLY for
# synthetic users and before any ledger write. Keep false unless you run it.
FAULT_INJECTION_ENABLED=false
# Key for the privacy-safe telemetry id (user_ref). Optional: defaults to a key
# derived from JWT_SECRET. Changing it changes every user_ref.
# USER_REF_SALT=

# --- Kibana export (bin/export-to-elastic.php) ---
# ES_URL=https://<elasticsearch-endpoint>
# ES_API_KEY=<encoded API key scoped to tensai-*>

# --- SecBank dashboards (bin/setup-elastic.php, bin/journey-health.php, bin/simulate.php) ---
# Separate key: logs-bank.*, metrics-bank.*, bank-* (write) + tensai-* (read).
# ES_BANK_API_KEY=<encoded API key>
# Simulated microservice traces go to the APM Server the PHP agent already uses: bin/simulate.php reads
# elastic_apm.server_url and elastic_apm.secret_token / api_key from the fpm php.ini, conf.d and pool config.
# Set these only to send somewhere else:
# APM_SERVER_URL=https://<apm-endpoint>
# APM_SECRET_TOKEN=<secret token>
# APM_API_KEY=<encoded APM API key>   (instead of the secret token)
# kibana/setup-kibana.mjs (journey SLOs, alert rules, ML jobs): Kibana endpoint and an API key created by a user
# with SLO, alerting and ML privileges (e.g. the deployment's elastic user, in Dev Tools).
# KIBANA_URL=https://<kibana-endpoint>
# KIBANA_API_KEY=<encoded API key>

# --- Synthetic seeder (bin/seed-test-data.php), optional ---
# SEED_USERS=5000
# SEED_TX_PER_USER=8
# SEED_PREFIX=tuser
# SEED_BCRYPT_ROUNDS=10

# --- 0010: data protection ---
# AES-256-GCM key for card numbers, tax PAN, date of birth and admin TOTP secrets (base64 of 32 bytes):
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Back it up outside the server; losing it makes the encrypted values unreadable. Never commit it.
APP_DATA_KEY=
