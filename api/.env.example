# Tensai SecBank — PHP API (Slim 4) environment template.
# Copy to .env and fill in. .env is gitignored.

# PostgreSQL. Must point at the SAME database the Node app used (data is preserved).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/tensai_secbank

# HTTP port the PHP app listens on (behind Apache/nginx reverse proxy at /api).
PORT=8090

# JWT signing secret. MUST be byte-identical to the Node app's JWT_SECRET so
# existing sessions/tokens keep working across the cutover.
JWT_SECRET=change-me-to-the-existing-node-secret

# Frontend origin(s) allowed by CORS (comma-separated).
CORS_ORIGIN=http://localhost:5173

# System user (used by POST /api/transactions/system/initial-funds).
SYSTEM_USER_EMAIL=system@tensai.local
SYSTEM_USER_PASSWORD=change-me

# Chatbot (optional). If ANTHROPIC_API_KEY is empty, the assistant falls back to
# the built-in deterministic rule-based responder (no external calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Synthetic seeder (bin/seed-test-data.php), optional ---
# SEED_USERS=5000
# SEED_TX_PER_USER=8
# SEED_PREFIX=tuser
# SEED_BCRYPT_ROUNDS=10
