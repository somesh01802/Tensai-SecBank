# --- Core ---
NODE_ENV=production
PORT=3000

# PostgreSQL connection URL. Leave blank in dev to use the embedded PGlite.
DATABASE_URL=postgres://tensai:CHANGE_ME@127.0.0.1:5432/tensai_secbank

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# CORS: comma-separated list of allowed origins. No trailing slash.
CORS_ORIGIN=http://localhost:5173

# Optional demo pending-state delay on legacy transfers (ms). 0 = instant.
TRANSFER_SIMULATION_DELAY_MS=0

# --- Seeded treasury / system user (override the code defaults) ---
SYSTEM_USER_EMAIL=treasury@tensaisec.local
SYSTEM_USER_PASSWORD=change-me

# --- Optional email OAuth (leave blank to disable emails) ---
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- AI assistant (Anthropic Claude) ---
# If unset, the chatbot runs in offline rule-based mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenTelemetry ---
# Set to "false" to disable telemetry entirely.
TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=tensai-secbank-api
# Elastic APM OTLP HTTP endpoint. The app appends /v1/traces, /v1/metrics, and /v1/logs.
OTEL_EXPORTER_OTLP_ENDPOINT=https://tensai.ingest.us-east-1.aws.elastic-cloud.com:443
# Set privately in backend/.env; do not commit API keys.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey <API_KEY>
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tensai,service.version=3.0.0,deployment.environment.name=production,banking.app=tensai-secbank,banking.component=backend
OTEL_ENV=production
# Set to "true" for verbose OTEL SDK diagnostics
OTEL_DEBUG=false
SERVICE_VERSION=3.0.0
