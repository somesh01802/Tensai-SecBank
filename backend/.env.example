# PostgreSQL connection URL.
# For dev, leave blank — `npm run dev` will boot an embedded PGlite at ./.pg-data.
# For production, point at a real Postgres:
#   postgres://user:password@host:5432/tensai_secbank
DATABASE_URL=

# JWT signing secret (generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-in-production

# Server port
PORT=3000

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGIN=http://localhost:5173

# Optional demo-only pending-state delay on transfers (ms). Default: 0 (instant).
# Set to 15000 to reproduce the original demo UX.
TRANSFER_SIMULATION_DELAY_MS=0

# Optional email OAuth (leave blank in dev)
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
