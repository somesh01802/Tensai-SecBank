# Continuous SYNTHETIC user journeys for the Kibana dashboards (api/bin/traffic.php).
# One instance per worker; each worker has its own pool of synthetic test users.
#   sudo cp deploy/tensai-traffic@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tensai-traffic@1 tensai-traffic@2 tensai-traffic@3
# Immediate stop (all workers, survives restarts):  sudo -u www-data php /var/www/tensai-secbank/api/bin/traffic.php --stop
#   …and to start again:                            sudo -u www-data php /var/www/tensai-secbank/api/bin/traffic.php --resume
#                                                   sudo systemctl restart 'tensai-traffic@*'
# Remove entirely: sudo systemctl disable --now 'tensai-traffic@*'
# Tune: sudo systemctl edit tensai-traffic@.service  (override ExecStart flags below)
[Unit]
Description=Tensai SecBank synthetic traffic (worker %i)
After=network-online.target apache2.service php8.1-fpm.service postgresql.service

[Service]
Type=simple
WorkingDirectory=/var/www/tensai-secbank/api
# ≤1 request/second per worker; 15% of money movements fail across all categories.
ExecStart=/usr/bin/php bin/traffic.php --worker=%i --users=25 --minutes=60 --rps=1 --think-ms=300 --fail-rate=0.15
Restart=always
RestartSec=5
# Exit code 75 = stop switch engaged (--stop): do not restart.
RestartPreventExitStatus=75
User=www-data
Nice=10
# Hardening (VAPT-29): no privilege gain, read-only /usr /boot /etc, no access to /home.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
# No PrivateTmp: the --stop switch file lives in the shared /tmp.

[Install]
WantedBy=multi-user.target
