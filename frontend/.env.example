# Frontend (Vite) environment template. Copy to .env to override defaults.

# API base. Defaults to /api (Vite dev proxies /api -> the backend).
# Set this for production builds pointing at a deployed backend.
# VITE_API_BASE_URL=http://localhost:8090/api

# --- Elastic RUM ---
# These values are shipped to the browser by design — they are NOT secrets.
# (The Elastic APM *secret token* is server-side only, in the PHP agent config.)

VITE_ELASTIC_RUM_SERVICE_NAME=tensai-secbank-web
VITE_ELASTIC_RUM_SERVER_URL=https://6131e45d909f42e4805c71ae8639c495.apm.us-east-1.aws.cloud.es.io:443
VITE_ELASTIC_RUM_ENVIRONMENT=production
VITE_ELASTIC_RUM_SERVICE_VERSION=0.1.0
# Origins (comma-separated) the RUM agent attaches distributed-tracing headers to,
# e.g. your API origin so browser transactions correlate with the PHP backend.
VITE_ELASTIC_RUM_ORIGINS=
